{
  "name": "@nidofy/dsh-desktop-pets",
  "version": "0.1.0",
  "description": "Independent DSH desktop pets, resource packages and Electron adapter",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./electron": {
      "types": "./lib/types/electron.d.ts",
      "default": "./lib/electron.js"
    },
    "./preload": "./lib/preload.cjs",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "LICENSE",
    "assets",
    "!assets/pets/xiaojing/portrait.png",
    "!assets/pets/xiaojing/spritesheet.png",
    "!assets/pets/xiaojing/preview.html",
    "!assets/pets/xiaojing/checksums.json",
    "!assets/pets/xiaojing/*.md",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "sharp": "^0.35.3",
    "@nidofy/dsh-plugin-shared": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "electron": ">=40",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2"
  },
  "devDependencies": {},
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
