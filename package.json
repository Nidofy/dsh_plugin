{
  "name": "dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "sandbox:prepare": "node scripts/sandbox-enhanced.mjs prepare",
    "sandbox:check": "node scripts/sandbox-enhanced.mjs check",
    "sandbox:smoke": "node scripts/sandbox-enhanced.mjs smoke",
    "village:check": "node scripts/ai-village-phase4.mjs check",
    "village:build": "node scripts/ai-village-release.mjs",
    "village:companions": "node scripts/ai-village-companions.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs && node scripts/sandbox-enhanced.mjs test",
    "pack": "node scripts/pack.mjs",
    "prepare:original": "node scripts/prepare-original.mjs",
    "test:original": "node scripts/test-original.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs && node scripts/sandbox-enhanced.mjs smoke && node scripts/offline-install-check.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run pack && npm run smoke:packed",
    "smoke:offline": "node scripts/offline-install-check.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "ui:check": "node scripts/plugin-ui-check.mjs",
    "smoke:runtime-install": "node scripts/runtime-install-check.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "vitest": "4.1.8",
    "vite-tsconfig-paths": "6.1.1",
    "jsdom": "29.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@testing-library/react": "^16.3.2",
    "js-yaml": "^4.2.0",
    "tar": "^7.5.0"
  }
}
